///$tab Main
SET ThousandSep='.';
SET DecimalSep=',';
SET MoneyThousandSep='.';
SET MoneyDecimalSep=',';
SET MoneyFormat='#.##0,00 €;-#.##0,00 €';
SET TimeFormat='h:mm:ss';
SET DateFormat='D/M/YYYY';
SET TimestampFormat='D/M/YYYY h:mm:ss[.fff]';
SET FirstWeekDay=0;
SET BrokenWeeks=0;
SET ReferenceDay=4;
SET FirstMonthOfYear=1;
SET CollationLocale='es-ES';
SET CreateSearchIndexOnReload=1;
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';
SET HidePrefix = '%';

///$tab Load
LET vPath = 'lib://Repo/data/modified/';

FOR EACH vFile IN FileList('$(vPath)*.qvd')

    // Nombre de la tabla = nombre del archivo sin ".qvd"
    LET vFileName = SubField('$(vFile)', '/', -1);
    LET vTable    = Left('$(vFileName)', Len('$(vFileName)') - 4);

    [$(vTable)]:
    LOAD * FROM [$(vFile)] (qvd);

    LET vRows = NoOfRows('$(vTable)');
    TRACE >>> $(vTable): $(vRows) filas;

NEXT vFile

///$tab Tablas Reporting Productos
[FlagDimensionesProductos]:
LOAD * Inline
[
%FlagDimensionesProductos
Purchase Year
Purchase Month
Purchase Date
Purchase Time
Purchase Public Holidays
Purchase Equivalent Day
Order ID
Order Line
Product ID
Product Category Name
Seller ID
Seller State
Seller City
Customer ID
Customer State
Customer City
Order Status
];


[FlagMedidasProductos]:
LOAD * Inline
[
%FlagMedidasProductos
Total Price
Total Freight
Total Amount
Freight Ratio
];

///$tab Tablas Reporting Pedidos
[FlagDimensionesPedidos]:
LOAD * Inline
[
%FlagDimensionesPedidos
Purchase Year
Purchase Month
Purchase Date
Purchase Time
Purchase Public Holidays
Purchase Equivalent Day
Order ID
Customer ID
Customer State
Customer City
Real Delivery Time
Estimated Delivery Time
Order Status
];


[FlagMedidasPedidos]:
LOAD * Inline
[
%FlagMedidasPedidos
Average Delivery Time
Average Delivery Delay
];

///$tab Exit Script
Exit Script;
